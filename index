  <style>
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');
    :root {
      --bg: #17131b; --panel: #211b26; --panel2: #29212e;
      --text: #f5eff7; --muted: #b8acbd; --gold: #d8b45a;
      --gold2: #f0d58d; --line: rgba(255,255,255,.09);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; color: var(--text); font-family: Manrope, Arial, sans-serif;
      background: radial-gradient(ellipse at 75% 8%, rgba(111,70,105,.22), transparent 34%), var(--bg);
    }
    a { color: inherit; text-decoration: none; }
    .wrap { width: min(1120px, calc(100% - 40px)); margin: auto; }
    header { position: sticky; top: 0; z-index: 10; background: rgba(23,19,27,.82); backdrop-filter: blur(16px); border-bottom: 1px solid var(--line); }
    nav { min-height: 76px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
    .brand { display:flex; align-items:center; gap:11px; font-weight:800; letter-spacing:.3px; }
    .brand-mark { width:38px; height:38px; display:grid; place-items:center; border-radius:13px; color:#201a20; background:linear-gradient(145deg,var(--gold2),#b88b37); box-shadow:0 6px 24px #d8b45a30; font-weight:900; }
    .links { display:flex; gap:28px; color:var(--muted); font-size:14px; }
    .links a:hover { color:var(--gold2); }
    .nav-btn,.btn { display:inline-flex; align-items:center; justify-content:center; border-radius:14px; padding:13px 20px; font-weight:800; font-size:14px; transition:.2s; }
    .nav-btn,.btn.primary { background:linear-gradient(135deg,var(--gold2),var(--gold)); color:#211a20; box-shadow:0 8px 26px #d8b45a25; }
    .btn:hover,.nav-btn:hover { transform:translateY(-2px); filter:brightness(1.06); }
    .hero { padding:86px 0 76px; display:grid; grid-template-columns:1.02fr .98fr; align-items:center; gap:42px; min-height:570px; }
    .eyebrow { display:inline-flex; gap:9px; align-items:center; color:var(--gold2); background:#d8b45a12; border:1px solid #d8b45a35; padding:8px 13px; border-radius:30px; font-size:12px; font-weight:800; letter-spacing:1.1px; text-transform:uppercase; }
    .dot { width:7px; height:7px; border-radius:50%; background:#9bd18b; box-shadow:0 0 12px #9bd18b; }
    h1 { font-size:clamp(42px,6vw,70px); line-height:1.04; letter-spacing:-3px; margin:22px 0 18px; }
    h1 span { color:var(--gold2); }
    .lead { max-width:520px; color:var(--muted); line-height:1.8; font-size:16px; }
    .actions { display:flex; gap:13px; flex-wrap:wrap; margin-top:30px; }
    .btn.secondary { border:1px solid var(--line); background:#ffffff08; }
    .small-note { margin-top:17px; color:#8f8495; font-size:12px; }
    .art { position:relative; min-height:390px; display:grid; place-items:center; }
    .glow { position:absolute; width:310px; height:310px; border-radius:50%; background:#b58b4830; filter:blur(65px); }
    .launcher-card { position:relative; width:min(100%,440px); padding:17px; border-radius:28px; background:linear-gradient(145deg,#342b38,#1d1822); border:1px solid #ffffff19; box-shadow:0 35px 90px #0008; transform:rotate(2deg); }
    .window-top { display:flex; align-items:center; gap:7px; padding:2px 4px 15px; color:#a99dac; font-size:11px; }
    .window-top i { width:7px; height:7px; border-radius:50%; background:#8d7186; }
    .scene { height:245px; border-radius:18px; overflow:hidden; position:relative; background:linear-gradient(#8a7189 0%,#c09b7d 55%,#52634b 56%,#263b31 100%); }
    .sun { position:absolute; width:65px;height:65px;border-radius:50%;background:#f4d69a;top:34px;right:54px;box-shadow:0 0 45px #f4d69a88; }
    .mountain { position:absolute; bottom:72px; width:0;height:0;border-left:100px solid transparent;border-right:100px solid transparent;border-bottom:140px solid #555064; }
    .m1 { left:10px; } .m2 { right:-5px; border-bottom-color:#6d5c6c; border-left-width:125px;border-right-width:125px; }
    .hill { position:absolute; bottom:-40px; left:-5%; width:110%; height:110px; background:#314b38; border-radius:50% 50% 0 0; }
    .tree { position:absolute; bottom:36px; width:18px;height:62px;background:#594332; }
    .tree:before { content:""; position:absolute; width:64px;height:64px;left:-23px;top:-37px;background:#304b38;clip-path:polygon(50% 0,100% 60%,75% 60%,100% 100%,0 100%,25% 60%,0 60%); }
    .t1 { left:70px; } .t2 { right:85px; transform:scale(.8); }
    .scene-label { position:absolute; left:18px; bottom:16px; font-size:10px; letter-spacing:2px; font-weight:800; color:#fff; text-shadow:0 2px 8px #000; }
    .playbar { display:flex; align-items:center; justify-content:space-between; padding:16px 5px 4px; }
    .version { color:#a99dac; font-size:11px; }
    .play { border:0; border-radius:12px; padding:12px 24px; background:linear-gradient(135deg,var(--gold2),var(--gold)); color:#211a20; font-weight:900; }
    .float-tag { position:absolute; right:-5px; top:36px; padding:12px 15px; background:#2a2230; border:1px solid #ffffff18; border-radius:14px; box-shadow:0 12px 35px #0006; font-size:12px; color:var(--gold2); }
    section { padding:74px 0; }
    .section-head { text-align:center; max-width:650px; margin:0 auto 38px; }
    .section-head h2 { font-size:clamp(28px,4vw,40px); margin:0 0 12px; letter-spacing:-1.3px; }
    .section-head p { color:var(--muted); line-height:1.7; margin:0; }
    .features { display:grid; grid-template-columns:repeat(3,1fr); gap:17px; }
    .feature { background:linear-gradient(145deg,#29222e,#211b26); border:1px solid var(--line); border-radius:22px; padding:25px; }
    .feature-icon { width:44px;height:44px;display:grid;place-items:center;border-radius:14px;background:#d8b45a17;color:var(--gold2);font-size:21px;margin-bottom:18px; }
    .feature h3 { margin:0 0 9px; font-size:17px; }
    .feature p { color:var(--muted); line-height:1.7; font-size:13px; margin:0; }
    .download-box { display:flex; align-items:center; justify-content:space-between; gap:25px; padding:34px; border-radius:26px; border:1px solid #d8b45a35; background:linear-gradient(120deg,#302632,#211b26); }
    .download-box h2 { margin:0 0 8px; font-size:27px; }
    .download-box p { color:var(--muted); margin:0; line-height:1.6; font-size:14px; }
    .socials { display:flex; justify-content:center; gap:14px; flex-wrap:wrap; }
    .social { min-width:180px; padding:18px 22px; border:1px solid var(--line); border-radius:17px; background:#ffffff06; text-align:center; font-weight:800; transition:.2s; }
    .social:hover { border-color:#d8b45a88; transform:translateY(-3px); }
    .social span { display:block; color:var(--muted); font-size:11px; font-weight:500; margin-top:5px; }
    footer { border-top:1px solid var(--line); padding:25px 0; color:#918697; font-size:12px; }
    footer .wrap { display:flex; justify-content:space-between; gap:15px; flex-wrap:wrap; }
    @media(max-width:800px) { .hero { grid-template-columns:1fr; padding:60px 0 35px; gap:12px; } .art { min-height:340px; } .features { grid-template-columns:1fr; } .links { gap:13px; } .nav-btn { display:none; } .download-box { flex-direction:column; align-items:flex-start; } }
    @media(max-width:480px) { .wrap { width:calc(100% - 28px); } .links { font-size:12px; gap:10px; } .brand { font-size:13px; } .brand-mark { width:33px;height:33px; } h1 { letter-spacing:-2px; } .launcher-card { padding:12px; } .scene { height:205px; } }
  </style>
